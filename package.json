{
  "name": "pro-screen-ai",
  "productName": "Pro Screen AI",
  "description": "Pro Screen AI \u2014 video ve yapay zeka g\u00f6rsel st\u00fcdyosu",
  "author": "webadderall",
  "homepage": "https://github.com/kancaba/Proscreenai",
  "repository": {
    "type": "git",
    "url": "https://github.com/kancaba/Proscreenai.git"
  },
  "bugs": {
    "url": "https://github.com/kancaba/Proscreenai/issues"
  },
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "npm run rebuild:native",
    "build": "npm run build:native-helpers && tsc && vite build && electron-builder",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "rebuild:native": "electron-rebuild --force --only uiohook-napi",
    "build:native-helpers": "node scripts/build-native-helpers.mjs",
    "build:wgc-capture": "node scripts/build-wgc-capture.mjs",
    "build:cursor-monitor": "node scripts/build-cursor-monitor.mjs",
    "build:mac": "npm run build:native-helpers && tsc && vite build && electron-builder --mac",
    "build:win": "npm run build:wgc-capture && npm run build:cursor-monitor && tsc && vite build && electron-builder --win",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest --run",
    "test:watch": "vitest",
    "build:app": "npm run build:native-helpers && tsc && vite build && electron-builder --mac --arm64 --dir --config.mac.identity=-",
    "typecheck": "tsc --noEmit",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test:desktop": "electron scripts/smoke-test.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@electron/rebuild": "^4.2.1",
    "@fix-webm-duration/fix": "^1.0.1",
    "@pixi/filter-drop-shadow": "^5.2.0",
    "@pixi/filter-motion-blur": "^5.1.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@types/gif.js": "^0.2.5",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@uiw/color-convert": "^2.9.2",
    "@uiw/react-color-block": "^2.9.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "capturekit": "^1.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dnd-timeline": "^2.2.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.7.0",
    "emoji-picker-react": "^4.16.1",
    "fast-check": "^4.5.2",
    "fix-webm-duration": "^1.0.6",
    "gif.js": "^0.2.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.545.0",
    "mediabunny": "^1.25.1",
    "motion": "^12.23.24",
    "mp4box": "^2.2.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.14.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-resizable-panels": "^3.0.6",
    "react-rnd": "^10.5.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.44.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.0.16",
    "web-demuxer": "^4.0.0"
  },
  "main": "dist-electron/main.js"
}
